#!/usr/bin/env bash
# open-california local pre-commit hook.
# Install once:  git config core.hooksPath .githooks
#
# Blocks the two things that keep going wrong (VW/vendor material or the real vehicle
# MAC getting committed) and keeps the suite + coverage guardrail green before a commit.
set -euo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

fail() { echo "pre-commit: BLOCKED — $1" >&2; exit 1; }

# 1) No VW/vendor binaries or extracted assets (belt-and-braces over .gitignore).
bad=$(staged | grep -iE '\.(apk|xapk|dex|jar|aar|aab|cvr|pcap|pcapng|pklg|btsnoop)$|(^|/)decompile/|(^|/)manuals/|ui/assets/svg/|strings_resolved' || true)
[ -z "$bad" ] || fail "vendor/binary material staged:"$'\n'"$bad"

# 2) No real vehicle BLE MAC (use a placeholder / env var instead). Match the unit's OUI
#    prefix + any suffix so this hook never embeds the full device MAC itself.
if staged | grep -qvE '^\.githooks/' && \
   staged | grep -vE '^\.githooks/' | xargs -r git diff --cached -- | grep -niE '20:81:9a(:[0-9a-f]{2}){3}' >/dev/null 2>&1; then
  fail "real vehicle BLE MAC (OUI 20:81:9A:…) in the diff — use a placeholder / env var"
fi

# 3) No VIN (17-char) in the diff.
if staged | xargs -r git diff --cached -- | grep -nE '\b[A-HJ-NPR-Z0-9]{17}\b' | grep -qiE 'WV2ZZZ|VIN'; then
  fail "a VIN appears in the diff — VINs are PII, keep them out of the repo"
fi

# 4a) Doc↔code consistency ALWAYS runs (even for docs-only SKIP_TESTS commits) — it's fast and
#     docs-only commits are exactly when prose drifts from the dictionary.
python3 -m pytest tests/test_doc_offset_consistency.py -q >/dev/null || \
  fail "doc/comment offset citations disagree with the dictionary (see test_doc_offset_consistency)"

# 4c) Fast CI guards that ALWAYS run (quick; catch drift docs-only commits cause too): runtime stays
#     stdlib-only at import, and the built web assets match source when the UI/semantics changed.
python3 -m tools.check_import_clean >/dev/null || \
  fail "runtime pulled a non-stdlib dep at import (see tools/check_import_clean.py)"
if git diff --cached --name-only | grep -qE '^(calictl/webui/|calictl/semantics\.py|ui/)'; then
  if ! python3 -m tools.build_web --out /tmp/oc_hook_screens.json >/dev/null 2>&1 \
       || ! diff -q /tmp/oc_hook_screens.json calictl/webui/screens.json >/dev/null; then
    fail "web assets stale — run: python3 -m tools.build_web"
  fi
fi

# 4d) ruff lint — NON-BLOCKING for now (the codebase isn't ruff-green yet; the tooling PR fixes that,
#     then this flips to a hard gate). Warn so regressions are visible without blocking. Whole-repo
#     check is sub-second, so no need to thread the staged file list (avoids word-split footguns).
if python3 -m ruff --version >/dev/null 2>&1; then
  python3 -m ruff check --quiet . >/dev/null 2>&1 || \
    echo "pre-commit: ruff has warnings (non-blocking — run: tools/ci.sh lint)" >&2
fi

# 4b) Full suite + coverage guardrail (skip with SKIP_TESTS=1 for docs-only commits). Parallel when
#     pytest-xdist is installed (tools/ci.sh dev), else serial.
if [ "${SKIP_TESTS:-0}" != "1" ]; then
  if python3 -c "import xdist" 2>/dev/null; then
    python3 -m pytest tests/ -q -n auto >/dev/null || fail "test suite is RED (SKIP_TESTS=1 to bypass)"
  else
    python3 -m pytest tests/ -q >/dev/null || fail "test suite is RED (SKIP_TESTS=1 to bypass)"
  fi
  python3 -m tools.audit_signals --report >/dev/null 2>&1 || \
    fail "signal-coverage/semantic-review audit failed"
fi

echo "pre-commit: OK"
