{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "buspi InfluxDB (bucket buspi)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    }
  ],
  "title": "VW California Camper",
  "uid": "vwcamper",
  "tags": [
    "camper",
    "vwcamper"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Water tanks (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"water\" and (r._field == \"fresh_percent\" or r._field == \"waste_percent\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Leisure battery (V)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt2_v\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fridge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF"
                },
                "1": {
                  "text": "ON"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"cooler\" and r._field == \"on\")\n  |> last()"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fridge level",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 5
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"cooler\" and r._field == \"level\")\n  |> last()"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "DC-DC charging",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle"
                },
                "1": {
                  "text": "charging"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"dcdc_charging\")\n  |> last()"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "USB charger",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off"
                },
                "1": {
                  "text": "on"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"campingmode\" and r._field == \"usb_charger\")\n  |> last()"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Charging power (W)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and (r._field == \"dcdc_power\" or r._field == \"shore_power\" or r._field == \"solar_power\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Fresh water \u2014 daily",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"water\" and r._field == \"fresh_percent\")\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Leisure battery \u2014 daily min/max",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "min",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt2_v\")\n  |> aggregateWindow(every: 1d, fn: min, createEmpty: false)\n  |> set(key: \"_field\", value: \"batt2_v_min\")"
        },
        {
          "refId": "max",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt2_v\")\n  |> aggregateWindow(every: 1d, fn: max, createEmpty: false)\n  |> set(key: \"_field\", value: \"batt2_v_max\")"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Leisure battery current (raw, unverified scale)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt2_current\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Battery SoC (0\u201315, like the van's bar)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizHeight": 10,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 15,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Leisure"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Starter"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"soc2_level\")\n  |> last()"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"soc1_level\")\n  |> last()"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Leisure runtime left",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt2_remaining_h\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)\n  |> last()"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Starter battery (V)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt1_v\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Source currents (raw, unverified scale)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"dcdc_current\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"shore_current\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        },
        {
          "refId": "C",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"solar_current\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Energy mode",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 30
      },
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "eco"
                },
                "1": {
                  "text": "normal"
                },
                "2": {
                  "text": "max"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"energy_mode\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)\n  |> last()"
        }
      ]
    }
  ]
}