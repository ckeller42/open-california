{
  "__inputs": [
    { "name": "DS_INFLUXDB", "label": "InfluxDB", "description": "buspi InfluxDB (bucket buspi)", "type": "datasource", "pluginId": "influxdb", "pluginName": "InfluxDB" }
  ],
  "__requires": [
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" },
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" }
  ],
  "title": "VW California Camper",
  "uid": "vwcamper",
  "tags": ["camper", "vwcamper"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Water tanks (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"water\" and (r._field == \"fresh_percent\" or r._field == \"waste_percent\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: last)" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Leisure battery (V)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "unit": "volt", "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"batt2_v\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last)" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Fridge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "OFF" }, "1": { "text": "ON" } } } ], "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"cooler\" and r._field == \"on\")\n  |> last()" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Fridge level",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "min": 0, "max": 5 }, "overrides": [] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"cooler\" and r._field == \"level\")\n  |> last()" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "DC-DC charging",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "idle" }, "1": { "text": "charging" } } } ], "thresholds": { "steps": [ { "color": "gray", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"energy\" and r._field == \"dcdc_charging\")\n  |> last()" }
      ]
    },
    {
      "id": 6, "type": "stat", "title": "USB charger",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "off" }, "1": { "text": "on" } } } ], "thresholds": { "steps": [ { "color": "gray", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "query": "from(bucket: \"buspi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"camper\" and r.function == \"campingmode\" and r._field == \"usb_charger\")\n  |> last()" }
      ]
    }
  ]
}
