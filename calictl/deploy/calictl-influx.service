[Unit]
Description=VW California Camper Unit (BLE) -> InfluxDB
After=bluetooth.target influxdb.service network-online.target
Wants=bluetooth.target network-online.target

[Service]
# solix-env has modern bleak + bleak-retry-connector + influxdb_client
ExecStart=/home/pi/solix-env/bin/python -m calictl influx
WorkingDirectory=/home/pi/open-california
EnvironmentFile=/etc/buspi/secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=POLL_INTERVAL=60
Restart=always
RestartSec=30
User=pi

[Install]
WantedBy=multi-user.target
