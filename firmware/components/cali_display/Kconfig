menu "calictl status display"
    config CALI_DISPLAY
        bool "Show device / WiFi / camper status on the CoreS3 screen"
        default y
        help
            Board package espressif/m5stack_core_s3 + LVGL. Off in the QEMU build (no screen).

    config CALI_DISPLAY_LANG_EN
        bool "English screen texts (default: German)"
        depends on CALI_DISPLAY
        default n
        help
            Texts come from firmware/web/strings.json (EN + DE), as on the web page.

    config CALI_DISPLAY_FORCE_FAIL
        bool "Test only: make display init fail"
        depends on CALI_DISPLAY
        default n
        help
            Test only. cali_display_init logs "display: unavailable (forced)" and returns -1 before
            touching I2C, to exercise the no-screen path on a board that has one. Never ship it.
endmenu
