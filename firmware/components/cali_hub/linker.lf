# cali_hub's static data (.bss) in PSRAM (CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY), as cali_core's:
# hub_esp.c runs on the owner task and the MQTT task only; no ISR and no DMA engine reads this data.
[mapping:cali_hub_extram]
archive: libcali_hub.a
entries:
    if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (extram_bss)
    else:
        * (default)
