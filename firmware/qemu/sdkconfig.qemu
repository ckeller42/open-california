# QEMU variant overlay (#154, Task 9): QEMU's esp32s3 machine emulates UART0, not the
# USB-Serial/JTAG the release image's console uses (sdkconfig.defaults, ruling R9). Build with
#   idf.py -B build-qemu -D SDKCONFIG=build-qemu/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;qemu/sdkconfig.qemu" build
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# The QEMU boot tier's probe (main/Kconfig.projbuild): no BT controller init (QEMU does not model it),
# plus the kvprobe console command. Never set in the release image (POST_BUILD check).
CONFIG_CALI_QEMU_PROBE=y
# No WiFi driver in the QEMU image (QEMU's esp32s3 models no WiFi radio): net_esp.c compiles no
# esp_wifi call, cali_net_esp_init() returns -1, app_main logs "LOG wifi: driver unavailable" and the
# WiFi SM stays WIFI_UNPROVISIONED (test_no_wifi_driver_boots_and_serves_nothing).
CONFIG_CALI_WIFI=n

# QEMU's esp32s3 has no screen (and no PSRAM model we rely on).
CONFIG_CALI_DISPLAY=n
CONFIG_SPIRAM=n

# The OTA test (tests/firmware/test_qemu_ota.py): QEMU's Ethernet (open_eth, DHCP from QEMU's user network) to
# a local release server on the host (10.0.2.2), over plain HTTP (no test CA in the image). Probe build only.
CONFIG_CALI_QEMU_ETH=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_CALI_OTA_URL_FMT="http://10.0.2.2:8070/esp-%s/"
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
